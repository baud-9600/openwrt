+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * mkdeadbeaf - Build Zyxel "deadbeaf" firmware images
+ *
+ * Used by: NWA5123-AC and similar Zyxel NWA access points.
+ *
+ * File layout (matching Zyxel's own tool):
+ *   [0:108]      pre-header   (magic, model_id, sizes, version, board, ...)
+ *   [108:380]    section 0 entry (272 bytes)
+ *   [380:652]    section 1 entry (272 bytes)
+ *   [648:1160]   sub-header   (512 bytes, overlaps last 4 bytes of s1 entry)
+ *   [1160:...]   section 0 kernel data (uImage)
+ *   [...:...]    section 1 rootfs data
+ *
+ * header_size is set to 648; ZLD treats bytes [648:1160) as the sub-header
+ * region and the uImage magic as being at byte 1160 (= flash kernel partition
+ * + 512). ZLD displays the version/date strings embedded in each section
+ * entry's padding (offset 204 and 236).
+ *
+ * Checksums (all md5 word-sum: sum of 4 big-endian 32-bit words from the
+ * MD5 digest, mod 2^32, with 0 remapped to 1):
+ *   - s0.checksum: md5ws over the kernel bytes only (file[1160:1160+kernel])
+ *   - s1.checksum: md5ws over the entire rootfs
+ *   - master_crc:  md5ws(file[4:]) with the 512 sub-header bytes [648:1160)
+ *                  temporarily zeroed; stored both at file[0:4] and inside
+ *                  the sub-header at offset 264.
+ *
+ * Copyright (C) 2024 OpenWrt.org
+ */
+
+#include <byteswap.h>
+#include <endian.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "md5.h"
+
+#if __BYTE_ORDER == __BIG_ENDIAN
+#define cpu_to_be16(x) (x)
+#define cpu_to_be32(x) (x)
+#elif __BYTE_ORDER == __LITTLE_ENDIAN
+#define cpu_to_be16(x) bswap_16(x)
+#define cpu_to_be32(x) bswap_32(x)
+#else
+#error "unsupported endianness"
+#endif
+
+#define DEADBEAF_MAGIC		0xDEADBEAFU
+#define PRE_HEADER_SIZE		108
+#define SECTION_ENTRY_SIZE	272
+#define HEADER_SIZE		648
+#define SUB_HDR_SIZE		512
+#define SUB_HDR_OFFSET		HEADER_SIZE          /* = 648 */
+#define KERNEL_DATA_OFFSET	(HEADER_SIZE + SUB_HDR_SIZE) /* = 1160 */
+#define FILENAME_LEN		64
+#define PARTITION_LEN		64
+#define VERSION_LEN		32
+#define DATE_LEN		32
+#define BLOCKSIZE		0x10000	/* 64k flash erase block */
+
+#define DEFAULT_KERNEL_OFFSET	0x00180000
+#define DEFAULT_ROOTFS_OFFSET	0x002A0000
+#define DEFAULT_MODEL_ID	0
+
+/* Sub-header checksum field offsets (bytes within the 512-byte sub-header). */
+#define SUBHDR_OFF_S0_CHECKSUM	260
+#define SUBHDR_OFF_MASTER_CRC	264
+#define SUBHDR_OFF_S1_CHECKSUM	268
+#define SUBHDR_OFF_MODEL_ID	272
+
+struct deadbeaf_header {
+	uint32_t master_crc;
+	uint32_t magic;
+	uint32_t type;
+	uint32_t model_id;
+	uint32_t reserved1;
+	uint32_t reserved2;
+	uint32_t file_size;
+	uint16_t header_size;
+	uint16_t pre_header_size;
+	uint32_t flags;
+	uint8_t  pad1[4];
+	char     version[32];
+	char     board[32];
+	uint16_t num_sections;
+	uint16_t pad2;
+} __attribute__((packed));
+
+struct section_entry {
+	uint32_t size;
+	uint32_t checksum;
+	uint32_t flash_offset;
+	char     filename[FILENAME_LEN];
+	char     partition[PARTITION_LEN];
+	uint8_t  pad_a[64];
+	char     version[VERSION_LEN];      /* offset 204 within section_entry */
+	char     date[DATE_LEN];            /* offset 236 */
+	uint32_t trailer;                   /* offset 268 */
+} __attribute__((packed));
+
+/*
