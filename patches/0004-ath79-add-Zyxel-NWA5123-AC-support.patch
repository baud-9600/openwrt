diff --git a/patches/0003-ath79-add-Zyxel-NWA5123-AC-support.patch b/patches/0003-ath79-add-Zyxel-NWA5123-AC-support.patch
new file mode 100644
index 0000000..e19a625
--- /dev/null
+++ b/patches/0003-ath79-add-Zyxel-NWA5123-AC-support.patch
@@ -0,0 +1,49 @@
+From: OpenWrt <noreply@openwrt.org>
+Subject: [PATCH] ath79: ath79 add Zyxel NWA5123 AC support
+
+---
+diff --git a/target/linux/ath79/image/generic.mk b/target/linux/ath79/image/generic.mk
+index ef156dd..409e4ec 100644
+--- a/target/linux/ath79/image/generic.mk
++++ b/target/linux/ath79/image/generic.mk
+@@ -169,6 +169,15 @@ define Build/zyxel-tar-bz2
+ 	rm -rf $@.tmp
+ endef
+ 
++define Build/zyxel-deadbeaf
++	$(STAGING_DIR_HOST)/bin/mkdeadbeaf \
++		-B $(1) \
++		-k $(IMAGE_KERNEL) \
++		-r $@ \
++		-o $@.new
++	mv $@.new $@
++endef
++
+ 
+ define Device/8dev_carambola2
+   SOC := ar9331
+@@ -3464,6 +3473,23 @@ define Device/zyxel_nwa1123-ni
+ endef
+ TARGET_DEVICES += zyxel_nwa1123-ni
+ 
++define Device/zyxel_nwa5123-ac
++  $(Device/loader-okli-uimage)
++  SOC := ar9344
++  DEVICE_VENDOR := Zyxel
++  DEVICE_MODEL := NWA5123-AC
++  DEVICE_PACKAGES := kmod-ath10k-ct-smallbuffers \
++	ath10k-firmware-qca988x-ct
++  LOADER_FLASH_OFFS := 0x180000
++  LOADER_FLASH_BASE := 0x1e000000
++  KERNEL := kernel-bin | append-dtb | lzma | uImage lzma -M 0x4f4b4c49
++  IMAGE_SIZE := 14848k
++  IMAGES += factory.bin
++  IMAGE/factory.bin := append-kernel | pad-to $$$$(BLOCKSIZE) | \
++	append-rootfs | pad-rootfs | check-size | zyxel-deadbeaf NWA5123-AC
++endef
++TARGET_DEVICES += zyxel_nwa5123-ac
++
+ define Device/zyxel_nbg6616
+   SOC := qca9557
+   DEVICE_VENDOR := Zyxel
+-- 
