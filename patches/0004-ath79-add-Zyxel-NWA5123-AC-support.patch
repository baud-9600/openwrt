diff --git a/patches/0005-firmware-utils-add-mkdeadbeaf-for-Zyxel-NWA5123-AC.patch b/patches/0005-firmware-utils-add-mkdeadbeaf-for-Zyxel-NWA5123-AC.patch
new file mode 100644
index 0000000..4dc353b
--- /dev/null
+++ b/patches/0005-firmware-utils-add-mkdeadbeaf-for-Zyxel-NWA5123-AC.patch
@@ -0,0 +1,332 @@
+From: OpenWrt <noreply@openwrt.org>
+Subject: [PATCH] ath79: firmware utils add mkdeadbeaf for Zyxel NWA5123 AC
+
+---
+diff --git a/scripts/mkdeadbeaf.c b/scripts/mkdeadbeaf.c
+new file mode 100644
+index 0000000..472b918
+--- /dev/null
++++ b/scripts/mkdeadbeaf.c
+@@ -0,0 +1,321 @@
++// SPDX-License-Identifier: GPL-2.0-or-later
++/*
++ * mkdeadbeaf - Build Zyxel "deadbeaf" firmware images
++ *
++ * Used by: NWA5123-AC and similar Zyxel NWA access points
++ *
++ * The firmware file has a 648-byte header followed by kernel and rootfs data.
++ * Checksums use MD5 word-sum: sum of 4 big-endian 32-bit words from the
++ * MD5 digest, mod 2^32 (returns 1 if result is 0).
++ *
++ * Copyright (C) 2024 OpenWrt.org
++ */
++
++#include <byteswap.h>
++#include <endian.h>
++#include <errno.h>
++#include <fcntl.h>
++#include <getopt.h>
++#include <stdint.h>
++#include <stdio.h>
++#include <stdlib.h>
++#include <string.h>
++#include <sys/stat.h>
++#include <unistd.h>
++
++#include "md5.h"
++
++#if __BYTE_ORDER == __BIG_ENDIAN
++#define cpu_to_be16(x) (x)
++#define cpu_to_be32(x) (x)
++#elif __BYTE_ORDER == __LITTLE_ENDIAN
++#define cpu_to_be16(x) bswap_16(x)
++#define cpu_to_be32(x) bswap_32(x)
++#else
++#error "unsupported endianness"
++#endif
++
++#define DEADBEAF_MAGIC		0xDEADBEAF
++#define PRE_HEADER_SIZE		108
++#define SECTION_ENTRY0_SIZE	272
++#define SECTION_ENTRY1_SIZE	268
++#define KERNEL_SUB_HDR_SIZE	512
++#define HEADER_SIZE		(PRE_HEADER_SIZE + SECTION_ENTRY0_SIZE + SECTION_ENTRY1_SIZE)
++#define FILENAME_LEN		64
++#define PARTITION_LEN		64
++
++/* Default flash offsets for NWA5123-AC */
++#define DEFAULT_KERNEL_OFFSET	0x00180000
++#define DEFAULT_ROOTFS_OFFSET	0x002A0000
++
++struct deadbeaf_header {
++	uint32_t master_crc;
++	uint32_t magic;
++	uint32_t type;
++	uint32_t model_id;
++	uint32_t reserved1;
++	uint32_t reserved2;
++	uint32_t file_size;
++	uint16_t header_size;
++	uint16_t pre_header_size;
++	uint32_t flags;
++	uint8_t  pad1[4];
++	char     version[32];
++	char     board[32];
++	uint16_t num_sections;
++	uint16_t pad2;
++} __attribute__((packed));
++
++struct section_entry0 {
++	uint32_t size;
++	uint32_t checksum;
++	uint32_t flash_offset;
++	char     filename[FILENAME_LEN];
++	char     partition[PARTITION_LEN];
++	uint8_t  pad[SECTION_ENTRY0_SIZE - 12 - FILENAME_LEN - PARTITION_LEN];
++} __attribute__((packed));
++
++struct section_entry1 {
++	uint32_t size;
++	uint32_t checksum;
++	uint32_t flash_offset;
++	char     filename[FILENAME_LEN];
++	char     partition[PARTITION_LEN];
++	uint8_t  pad[SECTION_ENTRY1_SIZE - 12 - FILENAME_LEN - PARTITION_LEN];
++} __attribute__((packed));
++
++static const char *progname;
++
++static uint32_t md5ws(const void *data, size_t len)
++{
++	MD5_CTX ctx;
++	uint8_t digest[16];
++	uint32_t w[4], sum;
++	int i;
++
++	MD5_Init(&ctx);
++	MD5_Update(&ctx, data, len);
++	MD5_Final(digest, &ctx);
++
++	for (i = 0; i < 4; i++)
++		w[i] = ((uint32_t)digest[i * 4] << 24) |
++		       ((uint32_t)digest[i * 4 + 1] << 16) |
++		       ((uint32_t)digest[i * 4 + 2] << 8) |
++		       ((uint32_t)digest[i * 4 + 3]);
++
++	sum = (w[0] + w[1] + w[2] + w[3]) & 0xFFFFFFFF;
++	return sum ? sum : 1;
++}
++
++static void *map_file(const char *path, size_t *size)
++{
++	struct stat st;
++	FILE *fp;
++	void *buf;
++
++	if (stat(path, &st)) {
++		fprintf(stderr, "%s: stat %s: %s\n", progname, path,
++			strerror(errno));
++		return NULL;
++	}
++	*size = st.st_size;
++
++	buf = malloc(*size);
++	if (!buf) {
++		fprintf(stderr, "%s: malloc(%zu): %s\n", progname, *size,
++			strerror(errno));
++		return NULL;
++	}
++
++	fp = fopen(path, "rb");
++	if (!fp) {
++		fprintf(stderr, "%s: open %s: %s\n", progname, path,
++			strerror(errno));
++		free(buf);
++		return NULL;
++	}
++
++	if (fread(buf, 1, *size, fp) != *size) {
++		fprintf(stderr, "%s: short read on %s\n", progname, path);
++		fclose(fp);
++		free(buf);
++		return NULL;
++	}
++
++	fclose(fp);
++	return buf;
++}
++
++static void usage(int status)
++{
++	fprintf(stderr,
++		"Usage: %s [OPTIONS]\n"
++		"  -B <board>     board name (required)\n"
++		"  -k <file>      kernel image (required)\n"
++		"  -r <file>      rootfs image (required)\n"
++		"  -o <file>      output file (required)\n"
++		"  -v <version>   firmware version string (default: 1.00.00)\n"
++		"  -K <offset>    kernel flash offset (default: 0x%x)\n"
++		"  -R <offset>    rootfs flash offset (default: 0x%x)\n"
++		"  -h             show this help\n",
++		progname, DEFAULT_KERNEL_OFFSET, DEFAULT_ROOTFS_OFFSET);
++	exit(status);
++}
++
++int main(int argc, char *argv[])
++{
++	struct deadbeaf_header hdr;
++	struct section_entry0 s0;
++	struct section_entry1 s1;
++	uint8_t sub_hdr[KERNEL_SUB_HDR_SIZE];
++	const char *board = NULL, *kernel_path = NULL;
++	const char *rootfs_path = NULL, *output_path = NULL;
