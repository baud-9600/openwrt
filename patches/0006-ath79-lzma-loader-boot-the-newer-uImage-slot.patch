From 44d1f89a5f3eb26a2517491a1d9525a0565f293a Mon Sep 17 00:00:00 2001
From: Manuel Kuklinski <mk@asdfghasdfgh.de>
Date: Sat, 7 Nov 2026 18:28:48 +0100
Subject: [PATCH] ath79: lzma-loader: boot the newer uImage slot

Both Zyxel NWA5123-AC flash slots can carry an OpenWrt uImage: ZLD/ATNZ always writes the inactive slot while the sticky bootImage flag keeps pointing at the old one. The loader previously preferred CS0 unconditionally, so an update written to CS1 was ignored.

Probe both slots, compare the uImage ih_time and boot the newer image. If only one slot carries a valid OKLI uImage, boot that one; equal timestamps keep the old CS0 preference.

The slot-mirror uci-defaults script now also mirrors the newer slot's loader stub into the other loader slot, so both chips run the same slot-selection logic regardless of which one ZLD picks. Update the README accordingly.
---
 .../99_zyxel-nwa5123-ac-slot-mirror           | 51 +++++++++----
 .../ath79/image/README-zyxel-nwa5123-ac.md    | 28 +++----
 .../ath79/image/lzma-loader/src/loader.c      | 74 ++++++++++++++++---
 3 files changed, 116 insertions(+), 37 deletions(-)

diff --git a/target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror b/target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror
index 3125a791e9..52f32f7468 100755
--- a/target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror
+++ b/target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror
@@ -13,16 +13,16 @@
 #                         CS1 (zy-image1-loader) stays stock Zyxel
 #   ZLD's auto-boot preference is sticky and bootbase's ATxx commands
 #   for flipping it are inaccessible on this device, so we can't force
-#   ZLD to boot our newly-flashed slot. The workaround is to put the
-#   OKLI stub into the OTHER slot too; the universal OKLI loader
-#   (LOADER_FLASH_CS0_FALLBACK) finds the real kernel+rootfs on
-#   whichever flash chip ZLD actually programmed.
+#   ZLD to boot our newly-flashed slot. The universal OKLI loader
+#   (LOADER_FLASH_CS0_FALLBACK) therefore probes both chips and boots
+#   the uImage with the newer ih_time timestamp, which is the slot
+#   ATNZ wrote last. This script mirrors that newer slot's loader stub
+#   into the other loader slot, so both chips run the same
+#   slot-selection logic after an update.
 #
-# Idempotent: skips the write if the destination slot already carries
-# the OKLI stub, so re-running after sysupgrade/factory doesn't wear
-# the flash. Preserves everything in the destination slot beyond the
-# first 1152k (= the kernel partition) so the recovery recipe can
-# still rebuild a bootable Zyxel image from a stock dump.
+# Preserves everything in the destination slot beyond the first 1152k
+# (= the kernel partition) so the recovery recipe can still rebuild a
+# bootable Zyxel image from a stock dump.
 
 . /lib/functions.sh
 
@@ -44,6 +44,11 @@ magic_at() {
 	dd if="$1" bs=1 count=4 2>/dev/null | hexdump -v -e '/1 "%02x"'
 }
 
+# uImage creation timestamp (ih_time, big-endian, offset 8)
+time_at() {
+	dd if="$1" bs=1 skip=8 count=4 2>/dev/null | hexdump -v -e '/1 "%02x"'
+}
+
 # Loader (sub_hdr + OKLI uImage stub) slots:
 cs0_loader_part=zy-image0
 cs1_loader_part=zy-image1-loader
@@ -64,14 +69,30 @@ fi
 
 cs0_fw_magic=$(magic_at "/dev/$cs0_fw_mtd")
 cs1_fw_magic=$(magic_at "/dev/$cs1_fw_mtd")
+cs0_fw_time=$(time_at "/dev/$cs0_fw_mtd")
+cs1_fw_time=$(time_at "/dev/$cs1_fw_mtd")
 
-# Figure out where ZLD just flashed OpenWrt by checking the OKLI
-# magic at the START of each firmware partition. The matching loader
-# slot (= same chip) is the source; the other chip's loader slot is
-# the destination.
+[ -n "$cs0_fw_time" ] || cs0_fw_time=00000000
+[ -n "$cs1_fw_time" ] || cs1_fw_time=00000000
+
+# Decide which loader stub to mirror. When both firmware slots carry
+# OpenWrt, the uImage with the newer ih_time is the one ATNZ wrote
+# last; its loader stub contains the matching slot-selection logic.
 if [ "$cs0_fw_magic" = "$OKLI_MAGIC" ] && [ "$cs1_fw_magic" = "$OKLI_MAGIC" ]; then
-	log "both firmware slots carry OpenWrt already, nothing to clone"
-	exit 0
+	if [ $((0x$cs1_fw_time)) -gt $((0x$cs0_fw_time)) ]; then
+		src_dev=/dev/$cs1_loader_mtd
+		dst_dev=/dev/$cs0_loader_mtd
+		dst_part=$cs0_loader_part
+		log "newer image on CS1 ($cs1_fw_time > $cs0_fw_time), mirroring loader into $dst_part"
+	elif [ $((0x$cs0_fw_time)) -gt $((0x$cs1_fw_time)) ]; then
+		src_dev=/dev/$cs0_loader_mtd
+		dst_dev=/dev/$cs1_loader_mtd
+		dst_part=$cs1_loader_part
+		log "newer image on CS0 ($cs0_fw_time > $cs1_fw_time), mirroring loader into $dst_part"
+	else
+		log "both firmware slots carry OpenWrt with the same timestamp, nothing to clone"
+		exit 0
+	fi
 elif [ "$cs0_fw_magic" = "$OKLI_MAGIC" ]; then
 	src_dev=/dev/$cs0_loader_mtd
 	dst_dev=/dev/$cs1_loader_mtd
diff --git a/target/linux/ath79/image/README-zyxel-nwa5123-ac.md b/target/linux/ath79/image/README-zyxel-nwa5123-ac.md
index 7edaf76673..fb18af5cab 100644
--- a/target/linux/ath79/image/README-zyxel-nwa5123-ac.md
+++ b/target/linux/ath79/image/README-zyxel-nwa5123-ac.md
@@ -68,18 +68,20 @@ Because ATNZ writes to the *inactive* slot:
 
 To make a single factory.bin work for both:
 
-1. **Universal OKLI loader** — the stub probes CS0's memory-mapped
-   region first (`LOADER_FLASH_CS0_FALLBACK=0x150000`); if it finds
-   the OKLI uImage magic there, it boots from CS0, otherwise it
-   falls back to SPI reads on CS1 at `0x2A0000`. One binary covers
-   both ex-factory flag values.
+1. **Universal OKLI loader** — the stub probes both chips: CS0's
+   memory-mapped `firmware2` (`LOADER_FLASH_CS0_FALLBACK=0x150000`)
+   and CS1's `firmware` (`LOADER_FLASH_OFFS=0x2A0000`, read via SPI).
+   It compares the uImage `ih_time` of both and boots the newer one;
+   if only one slot carries a valid OKLI uImage, that one is used.
+   This makes a freshly flashed (inactive) slot win regardless of the
+   sticky `bootImage` flag.
 2. **Slot-mirror on first boot** — the uci-defaults script
-   `99_zyxel-nwa5123-ac-slot-mirror` detects where ZLD actually
-   flashed OpenWrt (OKLI magic at offset 0 of `firmware` or
-   `firmware2`), clones the OKLI stub into the *other* slot's loader
-   partition, and preserves everything beyond the first 1152 KiB.
-   After that both slots carry our OKLI stub; whichever slot ZLD
-   picks on the next power-on boots OpenWrt.
+   `99_zyxel-nwa5123-ac-slot-mirror` detects which firmware slot has
+   the newer uImage (or the only OKLI slot), clones that slot's
+   loader stub into the *other* loader partition, and preserves
+   everything beyond the first 1152 KiB. After that both chips run
+   the same slot-selection logic; whichever slot ZLD picks on the
+   next power-on boots the newer OpenWrt image.
 3. **firmware2 partition on CS0** — the DT exposes `zy-image0`'s
    rootfs area as a second `openwrt,uimage` partition with
    `IH_MAGIC_OKLI`. On a `bootImage=1` unit, mtdsplit finds the OKLI
@@ -249,6 +251,6 @@ option reassociation_deadline '20000'
 |------|--------------|
 | `target/linux/ath79/dts/ar9344_zyxel_nwa5123-ac.dts` | DT: dual-chip partition table, `firmware2` on CS0, MAC/calibration nvmem, LEDs, keys, AR8035 RGMII delays |
 | `target/linux/ath79/image/generic.mk` (search `zyxel_nwa5123`) | Build recipe: deadbeaf wrapper, universal OKLI loader (CS0 fallback + CS1), factory.bin |
-| `target/linux/ath79/image/lzma-loader/src/loader.c` (`CONFIG_FLASH_CS1`, `CONFIG_FLASH_CS0_FALLBACK`) | OKLI stub: probe CS0 memory-mapped, fall back to CS1 SPI |
+| `target/linux/ath79/image/lzma-loader/src/loader.c` (`CONFIG_FLASH_CS1`, `CONFIG_FLASH_CS0_FALLBACK`) | OKLI stub: probe both slots, boot the newer uImage by `ih_time` |
 | `tools/firmware-utils/patches/100-add-mkdeadbeaf.patch` | Host tool that builds the deadbeaf image ZLD will accept |
-| `target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror` | One-shot: clones OKLI stub into the other loader slot on first boot |
+| `target/linux/ath79/generic/base-files/etc/uci-defaults/99_zyxel-nwa5123-ac-slot-mirror` | One-shot: clones the newer slot's loader stub into the other loader slot |
diff --git a/target/linux/ath79/image/lzma-loader/src/loader.c b/target/linux/ath79/image/lzma-loader/src/loader.c
index 9f4d10f65b..2fd581e131 100644
--- a/target/linux/ath79/image/lzma-loader/src/loader.c
+++ b/target/linux/ath79/image/lzma-loader/src/loader.c
@@ -288,31 +288,86 @@ static void lzma_init_data(void)
 		 * Some units (e.g. Zyxel NWA5123-AC with bootImage=1 ex
 		 * factory) end up with the OpenWrt payload on CS0 instead
 		 * of CS1 after ATNZ, because ZLD writes the inactive slot
-		 * and that slot sits on the opposite flash. Probe CS0
-		 * memory-mapped first, fall back to CS1 if nothing matches.
+		 * and that slot sits on the opposite flash.
+		 *
+		 * After an update both chips may carry a valid uImage: the
+		 * new image is written to the inactive slot while the old
+		 * one is still on the active slot, and ZLD's bootImage flag
+		 * is sticky. Probe both slots and boot the uImage with the
+		 * newer creation timestamp (ih_time), so a freshly flashed
+		 * slot wins regardless of which chip ZLD picked.
 		 */
 		{
 			unsigned char *cs0 = (unsigned char *)
 				KSEG1ADDR(0x1f000000 + CONFIG_FLASH_CS0_FALLBACK);
-			unsigned long cs0_magic = get_be32(cs0);
+			unsigned char *cs1 = buf;
+			unsigned long cs0_time = 0, cs1_time = 0;
+			int cs0_valid = 0, cs1_valid = 0;
+
+			magic = get_be32(cs0);
+#ifdef CONFIG_KERNEL_MAGIC
+			if (magic == CONFIG_KERNEL_MAGIC) {
+#else
+			if (magic == IH_MAGIC_OKLI) {
+#endif
+				cs0_valid = 1;
+				cs0_time = get_be32(cs0 +
+					offsetof(struct image_header, ih_time));
+			}
+
+			cs1_read(CONFIG_FLASH_OFFS, cs1,
+				 sizeof(struct image_header));
+			magic = get_be32(cs1);
 #ifdef CONFIG_KERNEL_MAGIC
-			if (cs0_magic == CONFIG_KERNEL_MAGIC) {
+			if (magic == CONFIG_KERNEL_MAGIC) {
 #else
-			if (cs0_magic == IH_MAGIC_OKLI) {
+			if (magic == IH_MAGIC_OKLI) {
 #endif
+				cs1_valid = 1;
+				cs1_time = get_be32(cs1 +
+					offsetof(struct image_header, ih_time));
+			}
+
+			if (cs1_valid && (!cs0_valid || cs1_time > cs0_time)) {
+				hdr = (struct image_header *) cs1;
+				hdr_size = sizeof(struct image_header);
+				kernel_size = get_be32(&hdr->ih_size);
+				kernel_la = get_be32(&hdr->ih_load);
+
+				printf("found @cs1+%08x, size=%u, time=%u\n",
+				       (unsigned)CONFIG_FLASH_OFFS,
+				       (unsigned)kernel_size,
+				       (unsigned)cs1_time);
+
+				cs1_read(CONFIG_FLASH_OFFS + hdr_size,
+					 buf + hdr_size, kernel_size);
+
+				lzma_data = buf + hdr_size;
+				lzma_datasize = kernel_size;
+				return;
+			}
+
+			if (cs0_valid) {
 				hdr = (struct image_header *) cs0;
 				kernel_size = get_be32(&hdr->ih_size);
 				kernel_la = get_be32(&hdr->ih_load);
-				printf("found @cs0+%08x, size=%u\n",
+
+				printf("found @cs0+%08x, size=%u, time=%u\n",
 				       (unsigned)CONFIG_FLASH_CS0_FALLBACK,
-				       (unsigned)kernel_size);
+				       (unsigned)kernel_size,
+				       (unsigned)cs0_time);
+
 				lzma_data = cs0 + sizeof(struct image_header);
 				lzma_datasize = kernel_size;
 				return;
 			}
-		}
-#endif /* CONFIG_FLASH_CS0_FALLBACK */
 
+			printf("not found! @cs0+%08x / @cs1+%08x\n",
+			       (unsigned)CONFIG_FLASH_CS0_FALLBACK,
+			       (unsigned)CONFIG_FLASH_OFFS);
+			halt();
+		}
+#else /* !CONFIG_FLASH_CS0_FALLBACK */
 		cs1_read(CONFIG_FLASH_OFFS, buf, sizeof(struct image_header));
 		magic = get_be32(buf);
 #ifdef CONFIG_KERNEL_MAGIC
@@ -339,6 +394,7 @@ static void lzma_init_data(void)
 		lzma_data = buf + hdr_size;
 		lzma_datasize = kernel_size;
 		return;
+#endif /* CONFIG_FLASH_CS0_FALLBACK */
 	}
 #endif
 
